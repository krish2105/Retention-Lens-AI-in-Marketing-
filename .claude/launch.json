{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "api",
      "runtimeExecutable": "/Users/krishnamathurm4pro/.local/bin/uv",
      "runtimeArgs": [
        "run",
        "--no-project",
        "--python",
        "3.12",
        "--with-requirements",
        "services/api/requirements.txt",
        "uvicorn",
        "app.main:app",
        "--app-dir",
        "services/api",
        "--port",
        "8001"
      ],
      "port": 8001
    },
    {
      "name": "web",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "apps/web",
        "run",
        "dev"
      ],
      "port": 3000
    }
  ]
}