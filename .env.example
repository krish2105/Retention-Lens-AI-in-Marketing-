# Copy to .env (never commit .env). Every value here is optional for local use.

# API
RL_AUTH_MODE=off                 # off | local | supabase
RL_DATABASE_URL=                 # postgresql://... to use Postgres instead of SQLite
RL_DB_SCHEMA=retentionlens       # Postgres schema for the API's tables
RL_CORS_ORIGINS=http://localhost:3000
RL_PUBLIC_WEB_URL=http://localhost:3000
RL_COOKIE_SECURE=0               # 1 when served over HTTPS (hosted)
RL_ADMIN_TOKEN=                  # long random string; protects /api/admin/waitlist
RL_HOLDOUT_SHARE=0.2
RL_QUEUE_SIZE=25
RL_RATE_LIMIT_PER_MIN=600
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:7b

# Supabase (RL_AUTH_MODE=supabase): Project Settings > API > JWT secret
SUPABASE_JWT_SECRET=

# Stripe TEST MODE only (sk_test_...). Live keys are refused.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_GROWTH=

# Web (apps/web/.env.local)
NEXT_PUBLIC_API_URL=http://localhost:8001
NEXT_PUBLIC_VERCEL_ANALYTICS=0
NEXT_PUBLIC_SUPABASE_URL=          # with RL_AUTH_MODE=supabase on the API
NEXT_PUBLIC_SUPABASE_ANON_KEY=     # public anon key, safe in the browser
